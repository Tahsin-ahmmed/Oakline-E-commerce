# ───────── Database ─────────
# PostgreSQL connection string. Example:
# postgresql://postgres:YOUR_PASSWORD@localhost:5432/lifestyle_ecommerce?schema=public
DATABASE_URL=

# Separate database used by the integration test suite (it is wiped between runs!)
TEST_DATABASE_URL=

# ───────── Auth ─────────
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Public base URL of the site (used for auth emails and redirects)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────── Initial Super Admin (read only by `npm run db:seed` / `npm run admin:create`) ─────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Owner
# Set to false in production to skip demo catalog/customers/orders
SEED_DEMO=true

# ───────── Cloudinary (product/banner/blog image uploads) ─────────
# Without these, uploads are disabled and admins can paste image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=oakline

# ───────── Stripe ─────────
# Without these, the Stripe option is hidden at checkout. Cash on Delivery always works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Currency Stripe charges in (lowercase ISO code). BDT is supported by Stripe for many accounts.
STRIPE_CURRENCY=bdt

# ───────── Email (SMTP) ─────────
# Without SMTP settings, emails are written to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Oakline <no-reply@example.com>"
# Where new-order and contact-form alerts are sent
ADMIN_NOTIFICATION_EMAIL=
